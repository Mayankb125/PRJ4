# =============================================================================
# WESAD Physiological Pipeline - .gitignore
# =============================================================================

# Large Datasets & Raw Archives (Gigabytes)
WESAD/
WESAD.zip
*.pkl
*.zip
*.tar.gz
*.7z
*.rar

# Binary NumPy Arrays (Large intermediate signal dumps)
*.npy

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Temporary & Scratch Files
plan_text.txt
*.log

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
