# =============================================================================
# WESAD Physiological Pipeline - .gitignore
# =============================================================================

# Large Datasets & Raw Archives (Gigabytes)
WESAD/
WESAD.zip
*.pkl
*.zip
*.tar.gz
*.7z
*.rar

# Binary NumPy Arrays (Large intermediate signal dumps)
*.npy

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Temporary & Scratch Files
plan_text.txt
*.log
Not/

# Local Live Test Sessions (keep 1 clean 3-min demo sample CSV for teammates)
RSP_Only_Model/live_sessions/
PhysioSync_Live/data/*.csv
!PhysioSync_Live/data/respiration_20261117_233731_20Hz.csv

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Frontend Node.js dependencies & builds
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
